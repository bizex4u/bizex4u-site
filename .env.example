# Form intake — see apps-script/SETUP.md for the fifteen-minute setup.
#
# Copy this file to .env.local and fill the values in. .env.local is
# gitignored; this example file is not, so never put real values here.
#
# Live forms post to Web3Forms. Set the same access key on Vercel as
# NEXT_PUBLIC_WEB3FORMS_KEY. The webhook / Resend vars below are the
# older /api/brief path and are no longer required for the UI.

NEXT_PUBLIC_WEB3FORMS_KEY=

# The Google Apps Script web app URL, ending in /exec
BRIEF_WEBHOOK_URL=

# Must match SHARED_TOKEN at the top of apps-script/Code.gs
BRIEF_WEBHOOK_TOKEN=

# Resend — optional second path so a brief is mailed even if the
# Sheet webhook is down. From must be a verified domain
# (e.g. Bizex4U <briefs@bizex4u.com>). Recipients are set in code:
# yash@bizex4u.com and vansh@bizex4u.com.
RESEND_API_KEY=
RESEND_FROM=

# PostHog — project API key from Project Settings → Project API Key.
# Host is the US cloud unless this project was created on EU cloud.
# Without the key, named events still go to Vercel Analytics on deploy.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
