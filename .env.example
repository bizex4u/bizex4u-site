# Form intake — see apps-script/SETUP.md for the fifteen-minute setup.
#
# Copy this file to .env.local and fill the values in. .env.local is
# gitignored; this example file is not, so never put real values here.
#
# Live forms post to Web3Forms. Set the same access key on Vercel as
# NEXT_PUBLIC_WEB3FORMS_KEY. The webhook / Resend vars below are the
# older /api/brief path and are no longer required for the UI.

NEXT_PUBLIC_WEB3FORMS_KEY=

# Canonical origin for og:url, twitter cards and metadataBase.
# No trailing slash. Set the same value on Vercel. If unset, metadata
# falls back to https://bizex4u.com via site.url.
NEXT_PUBLIC_SITE_URL=https://bizex4u.com

# The Google Apps Script web app URL, ending in /exec
BRIEF_WEBHOOK_URL=

# Must match SHARED_TOKEN at the top of apps-script/Code.gs
BRIEF_WEBHOOK_TOKEN=

# Resend — optional second path so a brief is mailed even if the
# Sheet webhook is down. From must be a verified domain
# (e.g. Bizex4U <briefs@bizex4u.com>). Recipients are set in code:
# yash@bizex4u.com and vansh@bizex4u.com.
RESEND_API_KEY=
RESEND_FROM=

# Plausible — hostname as registered in the Plausible dashboard, no
# scheme or path. The tracker is omitted when this is unset.
# Same value on Vercel (Production). Preview is skipped unless you also
# set NEXT_PUBLIC_PLAUSIBLE_DEV=true.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=bizex4u.com
# Site-specific v2 script from Site Installation in the dashboard.
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/pa-H1cPnWKxixH6m34YhowSM.js
# NEXT_PUBLIC_PLAUSIBLE_DEV=

# GA4 — measurement ID from Admin → Data streams. The tag is omitted
# when this is unset, and preview deployments are always skipped.
# Set the same value on Vercel (Production); NEXT_PUBLIC_ vars are
# inlined at build time, so .env.local alone does not reach deploys.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# PostHog — optional, not required for Plausible. Project API key from
# Project Settings → Project API Key. Host is the US cloud unless this
# project was created on EU cloud. Without the key, named events still
# go to Plausible (if the domain is set) and Vercel Analytics on deploy.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
